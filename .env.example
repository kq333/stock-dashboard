# Server-only. Never rename this with a VITE_ prefix.
NEWS_STOCK_API_KEY=replace_with_your_finnhub_api_key

# Optional CoinGecko demo key. VITE_ variables are visible in the browser.
VITE_COINGECKO_API_KEY=replace_with_your_coingecko_demo_api_key

# Optional public production URL for canonical links, e.g. https://your-project.vercel.app
VITE_SITE_URL=
